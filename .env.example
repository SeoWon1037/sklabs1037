# ============================================
# 서버 환경변수 예시
# - 이 파일을 복사해서 .env 를 만들고 실제 값을 채움 (.env 는 GitHub에 올리지 않음)
# ============================================

# DB (AWS RDS)
DB_URL=jdbc:postgresql://엔드포인트:5432/DB이름
DB_USERNAME=
DB_PASSWORD=

# 메일 (네이버 SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=

# 서비스 주소 (배포 주소로)
FRONTEND_URL=http://서버주소
NAVER_REDIRECT_URI=http://서버주소/api/oauth/naver/callback
KAKAO_REDIRECT_URI=http://서버주소/api/oauth/kakao/callback

# 소셜 로그인
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 토스증권 Open API
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Claude API
ANTHROPIC_API_KEY=
# 🤖 AI 자동 수정: 서버가 GitHub에 이슈를 만들고 PR을 합칠 때 (이 저장소만 · Issues/Pull requests/Contents 읽기·쓰기 fine-grained 토큰)
GITHUB_TOKEN=
