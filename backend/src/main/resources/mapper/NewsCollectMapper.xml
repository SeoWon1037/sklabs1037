<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    뉴스 수집 SQL
    namespace: 이 SQL을 쓸 Dao의 전체 경로
-->
<mapper namespace="com.sklabs1037.sklabs1037.news.dao.NewsCollectDao">

    <!--
        종목 뉴스 수집 대상: 주요 종목만
        (전 종목 약 3,000개를 30분마다 검색하면 구글 뉴스 차단 위험)
    -->
    <select id="selectTargetStocks"
            resultType="com.sklabs1037.sklabs1037.news.vo.NewsCollectVO">
        SELECT  ID AS STOCK_ID
        ,NAME
        FROM T_STOCK
        WHERE 1=1
        AND USE_YN = 'Y'
        AND FEATURED_YN = 'Y'
        AND DEL_DAY IS NULL
        ORDER BY ID
    </select>

    <!-- 뉴스 저장 (같은 기사 주소가 이미 있으면 저장하지 않음 → 저장된 건수 0 반환) -->
    <insert id="insertNews"
            parameterType="com.sklabs1037.sklabs1037.news.vo.NewsCollectVO">
        INSERT INTO T_NEWS
        ( STOCK_ID
        ,CATEGORY
        ,TITLE
        ,DESCRIPTION
        ,LINK
        ,PRESS
        ,PUB_DATE
        ) VALUES (
        #{stockId}
        ,#{category}
        ,#{title}
        ,#{description}
        ,#{link}
        ,#{press}
        ,#{pubDate}
        )
        ON CONFLICT (LINK) DO NOTHING
    </insert>

</mapper>